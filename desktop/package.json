{
  "name": "herramientas-del-master-desktop",
  "version": "1.83.0",
  "description": "Herramientas del Máster: app de escritorio para dirigir partidas de D&D 2024",
  "actualizaciones": {
    "provider": "github",
    "owner": "frekency",
    "repo": "herramientas-del-master"
  },
  "main": "main.js",
  "author": "Herramientas del Máster",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.mjs",
    "start": "node prepare.mjs && electron .",
    "dist:win": "node prepare.mjs && electron-builder --win",
    "dist:mac": "node prepare.mjs && electron-builder --mac",
    "dist": "node prepare.mjs && electron-builder --win --mac",
    "test": "node --test store.test.mjs mesa.test.mjs copias.test.mjs auth.test.mjs updater.test.mjs"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.herramientasdelmaster.app",
    "productName": "Herramientas del Máster",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "mesa-preload.js",
      "mesa.js",
      "copias.js",
      "auth.js",
      "updater.js",
      "imagenes.js",
      "package.json",
      "app/**/*",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "frekency",
        "repo": "herramientas-del-master",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Herramientas del Máster",
        "schemes": [
          "herramientasdelmaster"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-instalador-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
